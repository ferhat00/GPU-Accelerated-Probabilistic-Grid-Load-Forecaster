# Copy to `.env` and fill as needed. `.env` is gitignored.

# Path overrides (defaults shown — uncomment to change).
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts

# Force CPU paths everywhere. Set to 1 for laptops without a GPU.
# MOCK_GPU=0

# Copernicus CDS API key for ERA5 ingestion (phase 1).
# Register at https://cds.climate.copernicus.eu/api-how-to
# Approval typically takes ~24h — start this on day 1.
# CDS_API_KEY=
